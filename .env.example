# Example environment variables
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Google OAuth (for frontend oidc id_token verification)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET is only needed for server-side OAuth redirect flows
GOOGLE_CLIENT_SECRET=your-google-client-secret
# For server-side redirect flow (optional)
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Preset emails (comma-separated). If an email here signs in with Google,
# the backend will create the user with role defined in PRESET_EMAIL_ROLE.
# Example: PRESET_EMAILS=minhphuc242004@gmail.com,alice@example.com
PRESET_EMAILS=
# Role to assign for preset emails (default: admin)
PRESET_EMAIL_ROLE=admin
