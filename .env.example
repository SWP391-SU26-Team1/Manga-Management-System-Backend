# Server
PORT=5000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Internal API
INTERNAL_SERVICE_SECRET=replace-with-a-strong-random-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Optional preset role for Google login
PRESET_EMAILS=
PRESET_EMAIL_ROLE=admin

# Email (SMTP) Configuration
EMAIL_HOST=smtp.gmail.com          # Host of the mail service (e.g., smtp.gmail.com, SendGrid, Mailgun)
EMAIL_PORT=587                     # SMTP connection port (typically 587 for TLS, 465 for SSL)
EMAIL_SECURE=false                 # Set to true if using port 465, false if using port 587/other TLS ports
EMAIL_USER=your-email@gmail.com    # Sender email address
EMAIL_PASS=your-app-password       # Application password for SMTP authentication
EMAIL_FROM="MangaFlow Support" <your-email@gmail.com> # Display name and sender address (optional)
EMAIL_TO_DEV=your-email@gmail.com  # Redirect all outgoing OTP emails to this address in development mode to test actual email delivery (optional)

# AI Integrations (Groq & HuggingFace)
GROQ_API_KEY=your-groq-api-key
HF_API_KEY=your-huggingface-api-key
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
HF_COLORING_MODEL=stabilityai/stable-diffusion-3-medium-diffusers